{
  "name": "view-patch",
  "displayName": "View Patch",
  "description": "Review patches and patch series side by side, with complete Git-backed files or explicit repository-free hunk views.",
  "version": "0.3.2",
  "publisher": "waddahmoghram",
  "author": "Waddah Moghram",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/waddahmoghram/vscode-view-patch.git"
  },
  "bugs": {
    "url": "https://github.com/waddahmoghram/vscode-view-patch/issues"
  },
  "homepage": "https://github.com/waddahmoghram/vscode-view-patch#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "patch",
    "diff",
    "git",
    "format-patch",
    "review",
    "side by side",
    "changes",
    "compare"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Complete-file reviews run Git and require trust. Hunk-only views work without trust or Git."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Hunk-only reviews work on virtual files; complete-file reviews need a local Git repository."
    }
  },
  "activationEvents": [
    "onCustomEditor:viewPatch.editor",
    "onView:viewPatch.reviews"
  ],
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "viewPatch.open",
        "title": "Open Patch as Changes",
        "category": "View Patch",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "viewPatch.openWith",
        "title": "Open Patch as Changes on a Repository and Base...",
        "category": "View Patch"
      },
      {
        "command": "viewPatch.openHunks",
        "title": "View Patch Hunks Only",
        "category": "View Patch",
        "icon": "$(file-code)"
      },
      {
        "command": "viewPatch.openSeries",
        "title": "Open Selected Patches as Series...",
        "category": "View Patch",
        "icon": "$(git-commit)"
      },
      {
        "command": "viewPatch.refresh",
        "title": "Refresh Review",
        "category": "View Patch",
        "icon": "$(refresh)"
      },
      {
        "command": "viewPatch.changeBase",
        "title": "Change Repository and Base...",
        "category": "View Patch",
        "icon": "$(git-compare)"
      },
      {
        "command": "viewPatch.toggleReviewed",
        "title": "Toggle Reviewed",
        "category": "View Patch",
        "icon": "$(check)"
      },
      {
        "command": "viewPatch.filter",
        "title": "Filter Review Paths...",
        "category": "View Patch",
        "icon": "$(filter)"
      },
      {
        "command": "viewPatch.clearFilter",
        "title": "Clear Review Filter",
        "category": "View Patch",
        "icon": "$(clear-all)"
      },
      {
        "command": "viewPatch.showSummary",
        "title": "Show Patch Reviews",
        "category": "View Patch",
        "icon": "$(list-tree)"
      },
      {
        "command": "viewPatch.closeReview",
        "title": "Close Review",
        "category": "View Patch",
        "icon": "$(close)"
      },
      {
        "command": "viewPatch.openRecent",
        "title": "Reopen Recent Patch...",
        "category": "View Patch",
        "icon": "$(history)"
      },
      {
        "command": "viewPatch.compareWith",
        "title": "Compare with Another Patch...",
        "category": "View Patch",
        "icon": "$(diff)"
      },
      {
        "command": "viewPatch.exportSummary",
        "title": "Copy Review Summary as Markdown",
        "category": "View Patch",
        "icon": "$(markdown)"
      },
      {
        "command": "viewPatch.markAllReviewed",
        "title": "Mark All Reviewed",
        "category": "View Patch",
        "icon": "$(check-all)"
      },
      {
        "command": "viewPatch.clearReviewed",
        "title": "Clear Reviewed Checkmarks",
        "category": "View Patch"
      },
      {
        "command": "viewPatch.openSample",
        "title": "Open Sample Patch",
        "category": "View Patch"
      },
      {
        "command": "viewPatch.openFromClipboard",
        "title": "Open Patch from Clipboard",
        "category": "View Patch",
        "icon": "$(clippy)"
      },
      {
        "command": "viewPatch.reviewCommit",
        "title": "Review a Commit...",
        "category": "View Patch",
        "icon": "$(git-commit)"
      },
      {
        "command": "viewPatch.nextUnreviewed",
        "title": "Next Unreviewed File",
        "category": "View Patch",
        "icon": "$(arrow-down)"
      },
      {
        "command": "viewPatch.previousUnreviewed",
        "title": "Previous Unreviewed File",
        "category": "View Patch",
        "icon": "$(arrow-up)"
      },
      {
        "command": "viewPatch.copyFileDiff",
        "title": "Copy Diff for This File",
        "category": "View Patch",
        "icon": "$(copy)"
      },
      {
        "command": "viewPatch.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "View Patch"
      }
    ],
    "customEditors": [
      {
        "viewType": "viewPatch.editor",
        "displayName": "View Patch (Changes)",
        "selector": [
          {
            "filenamePattern": "*.patch"
          },
          {
            "filenamePattern": "*.diff"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "viewPatch.reviews",
          "name": "Patch Reviews",
          "contextualTitle": "View Patch",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "viewPatch.reviews",
        "contents": "Open a patch to review it here.\n[Open Patch as Changes](command:viewPatch.open)\n[View Hunks Only](command:viewPatch.openHunks)\n[Open Sample Patch](command:viewPatch.openSample)\n[Review a Commit...](command:viewPatch.reviewCommit)"
      }
    ],
    "walkthroughs": [
      {
        "id": "viewPatch.gettingStarted",
        "title": "Review your first patch",
        "description": "Open patches as native side-by-side Changes views, honestly and read-only.",
        "steps": [
          {
            "id": "viewPatch.step.sample",
            "title": "Try the built-in sample",
            "description": "One command opens a known-good demo patch - no repository or setup needed.\n[Open Sample Patch](command:viewPatch.openSample)",
            "media": { "markdown": "media/walkthrough/sample.md" },
            "completionEvents": ["onCommand:viewPatch.openSample"]
          },
          {
            "id": "viewPatch.step.open",
            "title": "Open a real patch",
            "description": "Right-click a .patch or .diff file, drag it onto Patch Reviews, or paste patch text.\n[Open Patch from Clipboard](command:viewPatch.openFromClipboard)",
            "media": { "markdown": "media/walkthrough/open.md" },
            "completionEvents": ["onCommand:viewPatch.open", "onCommand:viewPatch.openFromClipboard"]
          },
          {
            "id": "viewPatch.step.hunks",
            "title": "No repository? View hunks only",
            "description": "An explicitly partial view that never invents missing lines.\n[View Patch Hunks Only](command:viewPatch.openHunks)",
            "media": { "markdown": "media/walkthrough/hunks.md" },
            "completionEvents": ["onCommand:viewPatch.openHunks"]
          },
          {
            "id": "viewPatch.step.checklist",
            "title": "Track your review",
            "description": "The Patch Reviews panel keeps the repository, base, file list, and reviewed checkmarks - and they survive reloads.\n[Show Patch Reviews](command:viewPatch.showSummary)",
            "media": { "markdown": "media/walkthrough/checklist.md" },
            "completionEvents": ["onCommand:viewPatch.showSummary", "onCommand:viewPatch.toggleReviewed"]
          },
          {
            "id": "viewPatch.step.beyond",
            "title": "Compare versions and review commits",
            "description": "Diff two patch versions on one base, or review any commit straight from history.\n[Review a Commit...](command:viewPatch.reviewCommit)",
            "media": { "markdown": "media/walkthrough/beyond.md" },
            "completionEvents": ["onCommand:viewPatch.compareWith", "onCommand:viewPatch.reviewCommit"]
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "viewPatch.open",
          "when": "resourceExtname =~ /^\\.(diff|patch)$/i",
          "group": "3_compare@10"
        },
        {
          "command": "viewPatch.openWith",
          "when": "resourceExtname =~ /^\\.(diff|patch)$/i",
          "group": "3_compare@11"
        },
        {
          "command": "viewPatch.openHunks",
          "when": "resourceExtname =~ /^\\.(diff|patch)$/i",
          "group": "3_compare@12"
        },
        {
          "command": "viewPatch.openSeries",
          "when": "resourceExtname =~ /^\\.(diff|patch)$/i",
          "group": "3_compare@13"
        }
      ],
      "editor/title": [
        {
          "command": "viewPatch.open",
          "when": "resourceLangId == diff",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "viewPatch.filter",
          "when": "view == viewPatch.reviews",
          "group": "navigation@1"
        },
        {
          "command": "viewPatch.clearFilter",
          "when": "view == viewPatch.reviews && viewPatch.filtered",
          "group": "navigation@2"
        },
        {
          "command": "viewPatch.refresh",
          "when": "view == viewPatch.reviews && viewPatch.hasReviews",
          "group": "navigation@3"
        },
        {
          "command": "viewPatch.exportSummary",
          "when": "view == viewPatch.reviews && viewPatch.hasReviews",
          "group": "1_manage@1"
        },
        {
          "command": "viewPatch.markAllReviewed",
          "when": "view == viewPatch.reviews && viewPatch.hasReviews",
          "group": "1_manage@2"
        },
        {
          "command": "viewPatch.clearReviewed",
          "when": "view == viewPatch.reviews && viewPatch.hasReviews",
          "group": "1_manage@3"
        },
        {
          "command": "viewPatch.openRecent",
          "when": "view == viewPatch.reviews",
          "group": "1_manage@4"
        },
        {
          "command": "viewPatch.reviewCommit",
          "when": "view == viewPatch.reviews",
          "group": "1_manage@5"
        }
      ],
      "view/item/context": [
        {
          "command": "viewPatch.toggleReviewed",
          "when": "view == viewPatch.reviews && viewItem =~ /^viewPatch\\.file\\./",
          "group": "inline@1"
        },
        {
          "command": "viewPatch.copyFileDiff",
          "when": "view == viewPatch.reviews && viewItem =~ /^viewPatch\\.file\\./",
          "group": "1_actions@1"
        },
        {
          "command": "viewPatch.refresh",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "inline@1"
        },
        {
          "command": "viewPatch.changeBase",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "review@1"
        },
        {
          "command": "viewPatch.compareWith",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "review@2"
        },
        {
          "command": "viewPatch.exportSummary",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "review@3"
        },
        {
          "command": "viewPatch.markAllReviewed",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "review@4"
        },
        {
          "command": "viewPatch.clearReviewed",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "review@5"
        },
        {
          "command": "viewPatch.closeReview",
          "when": "view == viewPatch.reviews && viewItem == viewPatch.review",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "View Patch",
      "properties": {
        "viewPatch.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Extra Git repository folders to look in when a patch's repository is not open in this window. A leading `~` means your home folder."
        },
        "viewPatch.markReviewedOnOpen": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Mark a file's reviewed checkmark automatically when its individual diff is opened from Patch Reviews."
        },
        "viewPatch.gitTimeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 600,
          "scope": "machine",
          "description": "Maximum time for each Git command. Cancelling a review also stops its Git command."
        },
        "viewPatch.maxPatchSizeMiB": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 512,
          "scope": "machine",
          "description": "Maximum patch input size in mebibytes (1048576 bytes)."
        },
        "viewPatch.maxContentSizeMiB": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 2048,
          "scope": "machine",
          "description": "Maximum unique file content retained while loading one review, in mebibytes."
        },
        "viewPatch.maxOpenContentMiB": {
          "type": "integer",
          "default": 128,
          "minimum": 1,
          "maximum": 4096,
          "scope": "machine",
          "description": "Maximum file bytes retained by open reviews, in mebibytes. Open reviews are never evicted."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run compile:web",
    "compile": "tsc -p ./",
    "compile:web": "node esbuild.web.mjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"out/test/unit/**/*.test.js\"",
    "test:unit:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"out/test/**\" \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run test:editor && npm run test:restricted",
    "test:editor": "vscode-test",
    "test:restricted": "node scripts/test-restricted.mjs",
    "test:web": "node scripts/test-web.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "serialize-javascript": "^7.1.3"
  }
}
